# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/housing_platform?schema=public"

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Resend / Nodemailer)
EMAIL_FROM=no-reply@housingplatform.com
RESEND_API_KEY=your_resend_api_key

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Payment (SSLCommerz)
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false

# Admin seed credentials (demo)
ADMIN_EMAIL=admin@housing.com
ADMIN_PASSWORD=Admin@12345

# AI Assistant (Google Gemini — free tier via AI Studio)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest

# Frontend URL (for CORS / redirect)
CLIENT_URL=http://localhost:3000

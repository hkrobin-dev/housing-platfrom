        },
        {
          "name": "Get Room By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/rooms/{{roomId}}"
          }
        },
        {
          "name": "Update Room",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/rooms/{{roomId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rentAmount\": 13000\n}"
            }
          }
        },
        {
          "name": "Delete Room",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/rooms/{{roomId}}"
          }
        }
      ]
    },
    {
      "name": "Roommate Matching",
      "item": [
        {
          "name": "Upsert Roommate Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/roommates/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"budgetMin\": 8000,\n  \"budgetMax\": 15000,\n  \"gender\": \"any\",\n  \"lifestyleTags\": [\"non-smoker\", \"night-owl\"],\n  \"preferredLocation\": \"Dhaka\"\n}"
            }
          }
        },
        {
          "name": "Get My Roommate Profile",
          "request": {
            "method": "GET",

            "url": "{{baseUrl}}/properties/{{propertyId}}/rooms",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomNo\": \"A-101\",\n  \"rentAmount\": 12000,\n  \"capacity\": 2,\n  \"roomType\": \"SHARED\"\n}"
            }
          }
        },
        {
          "name": "List Rooms For Property",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/properties/{{propertyId}}/rooms"

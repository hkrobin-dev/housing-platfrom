{
  "info": {
    "name": "Housing & Roommate Management Platform API",
    "description": "Complete API collection for the Housing & Roommate Management Platform backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "propertyId",
      "value": ""
    },
    {
      "key": "roomId",
      "value": ""
    },
    {
      "key": "applicationId",
      "value": ""
    },
    {
      "key": "leaseId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Tenant\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123\",\n  \"role\": \"TENANT\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123\"\n}"
            }
          }
        },
        {
          "name": "Google Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/google",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"<google-id-token>\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout"
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/forgot-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}"
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/reset-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<token-from-email-link>\",\n  \"newPassword\": \"NewPassword123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "My Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/me/profile"
          }
        },
        {
          "name": "List Users (Admin)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Ban/Unban User (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/:id/ban",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isBanned\": true\n}"
            }
          }
        },
        {
          "name": "Verify User (Admin)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/users/:id/verify"
          }
        },
        {
          "name": "Update User Role (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/:id/role",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"OWNER\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Properties",
      "item": [
        {
          "name": "My Properties (Owner)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/properties/my"
          }
        },
        {
          "name": "Create Property (Owner)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/properties",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Sunrise Apartments\",\n  \"address\": \"123 Gulshan Ave\",\n  \"city\": \"Dhaka\",\n  \"type\": \"APARTMENT\",\n  \"amenities\": [\"wifi\", \"parking\"]\n}"
            }
          }
        },
        {
          "name": "List Properties (Public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/properties?city=Dhaka"
          }
        },
        {
          "name": "Get Property By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/properties/{{propertyId}}"
          }
        },
        {
          "name": "Update Property",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/properties/{{propertyId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Sunrise Apartments Updated\"\n}"
            }
          }
        },
        {
          "name": "Delete Property",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/properties/{{propertyId}}"
          }
        },
        {
          "name": "Upload Property Images",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/properties/{{propertyId}}/images",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "images",
                  "type": "file"
                }
              ]
            }
          }
        },
        {
          "name": "Get Active Tenants for Property",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/properties/{{propertyId}}/tenants"
          }
        },
        {
          "name": "Assign Manager",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/properties/{{propertyId}}/manager",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@example.com\"\n}"
            }
          }
        },
        {
          "name": "Remove Manager",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/properties/{{propertyId}}/manager"
          }
        }
      ]
    },
